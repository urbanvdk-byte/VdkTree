/* VdkTree v0.6.0 — mobile-first citizen map. */
:root{--green:#18753e;--ink:#183a2a;--edge:#d1e3d6;--muted:#64766a}
*{box-sizing:border-box}
html,body{margin:0;height:100%;font:15px system-ui,-apple-system,"Segoe UI",Arial,sans-serif;color:var(--ink);background:#eff6f0}
button,input,select,textarea{font:inherit}
header{height:60px;display:flex;align-items:center;gap:9px;padding:0 12px;background:#fff;box-shadow:0 2px 10px #103d1f1a;position:relative;z-index:1200}
header h1{font-size:clamp(14px,3.6vw,20px);line-height:1.15;margin:0;flex:1;min-width:0}
header .version{border-radius:12px;background:#e5f3e8;color:#17653a;font-size:11px;white-space:nowrap;padding:6px 8px;order:3}
#map{width:100%;height:calc(100dvh - 60px);z-index:0}
#controls{position:absolute;left:12px;top:74px;right:12px;z-index:900;display:flex;gap:8px;max-width:520px}
#controls select{flex:1;min-width:0}
#controls select,#controls button{background:white;border:1px solid var(--edge);border-radius:13px;padding:11px;box-shadow:0 3px 13px #0002}
#addButton{position:absolute;z-index:900;bottom:25px;left:50%;transform:translateX(-50%);border:0;color:white;background:var(--green);padding:15px 21px;box-shadow:0 5px 17px #073d1c55;border-radius:30px;font-weight:750;white-space:nowrap}
#addAreaButton{position:absolute;z-index:900;bottom:82px;left:50%;transform:translateX(-50%);border:0;border-radius:30px;background:#fff;color:#177240;padding:9px 15px;box-shadow:0 3px 12px #0003;display:none;font-weight:650;white-space:nowrap}
#toast{position:absolute;left:12px;bottom:91px;z-index:900;background:#fffef7;border:1px solid #f2dc99;box-shadow:0 2px 9px #0002;border-radius:11px;max-width:min(88vw,420px);font-size:12px;padding:9px 12px;pointer-events:none;line-height:1.4}
#toast:empty{display:none}
#legend{position:absolute;right:10px;bottom:22px;z-index:800;font-size:11px;background:#ffffffde;border-radius:10px;padding:8px 9px;box-shadow:0 2px 8px #0001}
#legend div{display:flex;align-items:center;gap:5px;margin:2px 0}
.legend-dot{width:9px;height:9px;border-radius:50%;display:inline-block}
.vdk-marker-shell{background:none;border:0}
.vdk-marker{position:relative;display:inline-block;width:21px;height:21px;top:2px;left:3px;border:2px solid #fff;border-radius:50%;box-shadow:0 1px 4px #0008}
.vdk-marker.tree.proposed{background:#9ca3af}
.vdk-marker.tree.confirmed{background:#259d55}
.vdk-marker.shrub{background:#42b8e6}
.vdk-marker.shrub.proposed{border:2px dashed #526875}
.vdk-marker.shrub.confirmed{border:2px solid #fff}
.vdk-alert{position:absolute;right:-5px;top:-7px;width:11px;height:11px;border:2px solid white;border-radius:50%;background:#e43d36;box-shadow:0 1px 3px #0005}
.vdk-marker.local{background:#e8b44d;border:2px dashed #6e592c}
.leaflet-container{font:inherit}
.leaflet-control-attribution{font-size:10px!important;background:#ffffffd5!important}
dialog{border:0;border-radius:17px;box-shadow:0 16px 55px #0005;padding:20px;width:min(94vw,460px);max-height:90dvh;overflow:auto}
dialog::backdrop{background:#0b251e7e}
dialog h2{font-size:19px;margin:0 0 8px}
dialog h3{font-size:15px;margin:15px 0 6px}
dialog p{line-height:1.5;font-size:13px}
dialog small,.help{font-size:12px;color:var(--muted)}
dialog form{display:grid;gap:10px}
dialog label{display:grid;gap:5px;font-size:13px;font-weight:600}
dialog input,dialog textarea,dialog select{border:1px solid #cbdace;border-radius:9px;width:100%;padding:10px;color:var(--ink);background:white}
dialog textarea{resize:vertical;min-height:70px}
dialog button,.panel-btn{padding:11px 12px;border:0;border-radius:10px;background:var(--green);color:#fff;font-weight:700;cursor:pointer}
dialog button.secondary,.panel-btn.secondary{background:#e8f0e9;color:#214630}
dialog button.warning{background:#b44632}
.dialog-actions{display:flex;gap:8px;flex-wrap:wrap}
.dialog-actions>*{flex:1}
#editor-status,#detail-status{font-size:12px;min-height:1.4em;white-space:pre-wrap;overflow-wrap:anywhere}
.error{color:#ac3128}
#damage-group{display:flex;flex-wrap:wrap;gap:9px 13px}
#damage-group label{display:flex;align-items:center;gap:5px;font-size:12px;font-weight:500}
#damage-group input{width:auto}
#card-content img{display:block;max-width:100%;max-height:260px;object-fit:contain;border-radius:10px;margin-top:10px}
#card-content .note{background:#f6f9f6;border:1px solid #e1eae3;border-radius:9px;padding:9px 11px;margin:8px 0}
#card-content .meta{color:#6c7e73;font-size:12px}
#card-content .badge{display:inline-block;padding:3px 8px;border-radius:20px;font-size:12px;background:#e6f2e8}
#card-content .badge.note-badge{background:#fbe5e3;color:#a02e27}
#drawControls{position:absolute;z-index:950;left:12px;bottom:158px;right:12px;max-width:450px;background:#fff;border-radius:12px;padding:12px;box-shadow:0 3px 16px #0003;display:none}
#drawControls p{font-size:13px;margin:0 0 8px}
#drawControls button{border:0;border-radius:8px;background:#217a44;color:white;padding:10px;margin-right:6px}
#drawControls button.secondary{background:#e6eeea;color:#214630}
@media(max-width:500px){#legend{bottom:130px;right:9px}#toast{bottom:92px;right:10px;left:10px;max-width:none;text-align:center}#drawControls{bottom:145px}}
