<!doctype html><html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>VdkTree — карта деревьев</title><link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"><link rel="stylesheet" href="./auth/auth.css"><style>*{box-sizing:border-box}body{margin:0;font:15px system-ui,Arial;color:#244332}header{height:62px;background:white;display:flex;align-items:center;justify-content:space-between;padding:0 15px;box-shadow:0 1px 9px #0002;position:relative;z-index:1001}h1{font-size:19px;margin:0}.version{color:#21733e;background:#e7f3e8;border-radius:20px;padding:5px 9px;font-size:12px}#map{height:calc(100dvh - 62px)}.tools{position:absolute;z-index:1000;top:74px;left:12px;right:12px;max-width:480px;display:flex;gap:8px}.tools select,.tools button{background:#fff;border:1px solid #d6e1d7;border-radius:12px;padding:12px;box-shadow:0 2px 8px #0002}.tools select{flex:1}.add{position:absolute;z-index:1000;bottom:25px;left:50%;transform:translateX(-50%);background:#18753e;color:white;border:0;border-radius:30px;padding:16px 22px;font-weight:bold;white-space:nowrap;box-shadow:0 3px 12px #0005}dialog{border:0;border-radius:16px;padding:20px;width:min(94vw,420px);max-height:90dvh;overflow:auto}dialog::backdrop{background:#0008}form{display:grid;gap:10px}input,select,textarea{width:100%;padding:11px;border:1px solid #ccd9ce;border-radius:9px;font:inherit}label{font-size:13px;font-weight:600}form button{padding:12px;border:0;border-radius:9px;background:#18753e;color:white;font-weight:bold}.cancel{background:#e8eee8;color:#26402f}.notice{position:absolute;z-index:1000;bottom:90px;left:12px;right:12px;margin:auto;max-width:410px;text-align:center;background:#fffdf1;border:1px solid #e9d99a;padding:9px;border-radius:10px;font-size:12px;pointer-events:none}.popup img{max-width:220px;max-height:170px;display:block;border-radius:8px;margin-top:8px}small{color:#65776a}</style></head><body><header><h1>🌳 Деревья Владивостока</h1><span class="version">v0.4.2</span></header><div id="map"></div><div class="tools"><select id="filter"><option value="all">Все деревья</option><option value="healthy">🟢 Здоровые</option><option value="damaged">🟠 Повреждённые</option><option value="dead">🔴 Погибшие</option></select><button id="locate">📍 Я здесь</button></div><div class="notice">Демо: записи сохраняются только в этом браузере, не видны другим жителям.</div><button class="add" id="add">＋ Добавить дерево</button><dialog id="dialog"><form id="form"><h2 style="margin:0">Новое дерево</h2><small>Выберите точку на карте или поправьте координаты вручную.</small><label>Широта<input name="lat" type="number" step="any" required></label><label>Долгота<input name="lon" type="number" step="any" required></label><label>Порода<input name="species" maxlength="80" required placeholder="Например, дуб монгольский"></label><label>Состояние<select name="condition"><option value="healthy">Здоровое</option><option value="damaged">Повреждено</option><option value="dead">Погибло</option></select></label><label>Высота, м<input name="height" type="number" step="0.1" min="0.1" max="100"></label><label>Диаметр ствола, см<input name="diameter" type="number" step="0.1" min="0.1" max="1000"></label><label>Фото (JPG, PNG, WebP; до 1 МБ в демо)<input name="photo" type="file" accept="image/jpeg,image/png,image/webp"></label><label>Комментарий<textarea name="comment" maxlength="1000" rows="3"></textarea></label><button type="submit">Сохранить</button><button type="button" id="cancel" class="cancel">Отмена</button><small id="error" role="status"></small></form></dialog><script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script><script>const map=L.map('map').setView([43.1155,131.8855],13);L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:19,attribution:'© OpenStreetMap contributors'}).addTo(map);const KEY='vdktree-demo-v020',dlg=document.getElementById('dialog'),form=document.getElementById('form'),filter=document.getElementById('filter'),layer=L.layerGroup().addTo(map);let trees=[];try{trees=JSON.parse(localStorage.getItem(KEY)||'[]');if(!Array.isArray(trees))trees=[]}catch{trees=[]}const names={healthy:'Здоровое',damaged:'Повреждено',dead:'Погибло'},colors={healthy:'#26924b',damaged:'#e89924',dead:'#ce4545'};function safe(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}function render(){layer.clearLayers();for(const t of trees){if(filter.value!=='all'&&filter.value!==t.condition)continue;const marker=L.circleMarker([t.lat,t.lon],{radius:9,color:'#fff',weight:2,fillColor:colors[t.condition],fillOpacity:1}).addTo(layer);const p=document.createElement('div');p.className='popup';p.innerHTML='<b>'+safe(t.species)+'</b><p>'+safe(names[t.condition])+'</p>'+(t.height?'<p>Высота: '+safe(t.height)+' м</p>':'')+(t.diameter?'<p>Диаметр: '+safe(t.diameter)+' см</p>':'')+(t.comment?'<p>'+safe(t.comment)+'</p>':'');if(t.photo){const img=document.createElement('img');img.src=t.photo;img.alt='Фото дерева';p.append(img)}marker.bindPopup(p)}}function openForm(point){form.reset();form.elements.lat.value=point.lat.toFixed(6);form.elements.lon.value=point.lng.toFixed(6);document.getElementById('error').textContent='';dlg.showModal()}map.on('click',e=>openForm(e.latlng));document.getElementById('add').onclick=()=>openForm(map.getCenter());document.getElementById('cancel').onclick=()=>dlg.close();document.getElementById('locate').onclick=()=>map.locate({setView:true,maxZoom:17});map.on('locationerror',()=>alert('Геолокация недоступна. Разрешите доступ в браузере.'));filter.onchange=render;form.onsubmit=async e=>{e.preventDefault();const f=form.elements,lat=Number(f.lat.value),lon=Number(f.lon.value),err=document.getElementById('error');if(!(lat>=42&&lat<=44&&lon>=130&&lon<=134)){err.textContent='Точка должна быть в районе Владивостока';return}const file=f.photo.files[0];if(file&&(!['image/jpeg','image/png','image/webp'].includes(file.type)||file.size>1024*1024)){err.textContent='Допустимо JPG/PNG/WebP до 1 МБ';return}let photo=null;if(file){photo=await new Promise((resolve,reject)=>{const reader=new FileReader();reader.onload=()=>resolve(reader.result);reader.onerror=()=>reject(new Error('Ошибка чтения фото'));reader.readAsDataURL(file)})}const record={id:crypto.randomUUID(),lat,lon,species:f.species.value.trim(),condition:f.condition.value,height:f.height.value,diameter:f.diameter.value,comment:f.comment.value.trim(),photo,createdAt:Date.now()};if(!record.species){err.textContent='Укажите породу';return}try{localStorage.setItem(KEY,JSON.stringify([...trees,record]));trees.push(record);dlg.close();render()}catch{err.textContent='Не хватает памяти браузера для фото. Попробуйте меньший файл.'}};render();window.VdkApp={map,layer,render,openForm,localTrees:trees};</script><script src="https://st.max.ru/js/max-web-app.js"></script><script src="./auth/config.js"></script><script src="./auth/client.js"></script></body></html>