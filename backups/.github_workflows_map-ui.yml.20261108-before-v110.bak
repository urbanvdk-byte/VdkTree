name: VdkTree shared map UI checks
on:
  push:
    branches: [main]
    paths:
      - index.html
      - ui/**
      - .github/workflows/map-ui.yml
      - tests/test_map_ui.js
      - tests/test_users_ui.js
  pull_request:
    branches: [main]
    paths:
      - index.html
      - ui/**
      - .github/workflows/map-ui.yml
      - tests/test_map_ui.js
permissions:
  contents: read
jobs:
  map-ui:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Verify map and admin JavaScript
        run: node --check ui/map.js && node --check ui/management.js
      - name: Verify UI contract
        run: node tests/test_map_ui.js && node tests/test_users_ui.js
