name: VdkTree authentication checks
on:
  push:
    branches: [main]
  pull_request:
    branches: [main]
permissions:
  contents: read
jobs:
  test:
    runs-on: ubuntu-latest
    services:
      postgres:
        image: postgres:16-alpine
        env:
          POSTGRES_USER: vdktree_ci
          POSTGRES_PASSWORD: ci_only_password
          POSTGRES_DB: vdktree_ci
        ports:
          - 5432:5432
        options: >-
          --health-cmd "pg_isready -U vdktree_ci -d vdktree_ci"
          --health-interval 5s
          --health-timeout 5s
          --health-retries 20
    env:
      DATABASE_URL: postgresql://vdktree_ci:ci_only_password@127.0.0.1:5432/vdktree_ci
      MAX_BOT_TOKEN: test-bot-token-never-real
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'
      - name: Install dependencies
        run: python -m pip install -r requirements.txt pytest httpx
      - name: Reproduce pre-existing public.users with INTEGER id
        run: |
          python - <<'PY'
          import os
          import psycopg
          with psycopg.connect(os.environ["DATABASE_URL"]) as db:
              db.execute("CREATE TABLE public.users (id INTEGER PRIMARY KEY)")
              db.execute("INSERT INTO public.users(id) VALUES (1234)")
          PY
      - name: Seed existing savenko before loading admin startup migration
        run: |
          python - <<'PY'
          import time
          from auth_backend import connect
          with connect() as db:
              db.execute("INSERT INTO users(id,max_id,display_name,login,created_at) VALUES (?,?,?,?,?)",
                         ("seed-savenko-v103", "ci-test-existing", "Участник Savenko", "savenko", int(time.time())))
          from app import app
          with connect() as db:
              row=db.execute("SELECT role FROM users WHERE login='savenko'").fetchone()
              assert row["role"] == "admin", row
              migration=db.execute("SELECT outcome FROM admin_bootstrap_history WHERE marker=?",
                                   ("v1.0.3:existing-login:savenko",)).fetchone()
              assert migration["outcome"] == "promoted", migration
          PY
      - name: Compile Python
        run: python -m compileall -q app.py auth_backend.py inventory_api.py moderation_api.py expert_api.py import_api.py users_admin_api.py pgdb.py tests
      - name: Check JavaScript syntax
        run: node --check auth/client.js && node --check ui/map.js && node --check ui/management.js
      - name: Test PostgreSQL MAX and inventory
        run: python -m pytest -q
